--
-- This module defines a trust registry for KYC (Know Your Customer) providers.
-- It allows a designated authority to maintain a list of trusted identity
-- providers, which can then be queried by other parties on the network to
-- verify the legitimacy of a KYC attestation.
--

module KYC.TrustRegistry where

import Daml.Finance.Interface.Util.Disclosure qualified as Disclosure (I, Implementation, View(..), setObserversImpl, view)
import DA.Set (Set)
import DA.Set qualified as Set

-- | A registry contract that maintains a set of trusted KYC providers.
-- The `authority` is the entity responsible for managing the list of providers.
-- This contract is observable by the authority, all listed providers, and any
-- explicitly added observers.
template ProviderRegistry
  with
    authority : Party
      -- ^ The party that manages the registry.
    providers : Set Party
      -- ^ The set of parties recognized as trusted KYC providers.
    observers : Set Party
      -- ^ Additional parties who can observe the registry's state.
  where
    signatory authority
    observer union [providers, observers, Set.singleton authority]

    key authority : Party
    maintainer key.authority

    interface instance Disclosure.I for ProviderRegistry where
      view = Disclosure.View with
        disclosingParties = Set.singleton authority
        observers
      setObservers = Disclosure.setObserversImpl

    -- | Choice for the authority to add a new KYC provider to the trusted set.
    choice AddProvider : ContractId ProviderRegistry
      with
        newProvider : Party
          -- ^ The party to be added as a trusted provider.
      controller authority
      do
        assertMsg "Provider is already in the registry." $
          not $ Set.member newProvider providers
        create this with providers = Set.insert newProvider this.providers

    -- | Choice for the authority to remove a KYC provider from the trusted set.
    choice RemoveProvider : ContractId ProviderRegistry
      with
        providerToRemove : Party
          -- ^ The party to be removed from the trusted provider list.
      controller authority
      do
        assertMsg "Provider is not in the registry." $
          Set.member providerToRemove providers
        create this with providers = Set.delete providerToRemove this.providers

    -- | Non-consuming choice to check if a given party is a trusted provider.
    -- This can be called by any observer of the contract.
    nonconsuming choice IsProviderTrusted : Bool
      with
        providerToCheck : Party
          -- ^ The party whose trust status is being queried.
      controller union [observers, providers, Set.singleton authority]
      do
        return $ Set.member providerToCheck providers

-- | Helper type for fetching a `ProviderRegistry` contract by its key.
type ProviderRegistryKey = Party

-- | Interface to abstract over the functionality of a trust registry.
-- This allows other contracts to depend on the interface rather than the
-- concrete `ProviderRegistry` template, making the system more modular.
interface Registry where
  viewtype V

  -- | Retrieves the view of the registry.
  asProviderRegistry : ProviderRegistry
  asProviderRegistry = toInterface @Registry self

  -- | Checks if a provider is trusted.
  isTrusted : Party -> Update Bool
  -- | Adds a provider to the registry.
  addProvider : Party -> Update (ContractId Registry)
  -- | Removes a provider from the registry.
  removeProvider : Party -> Update (ContractId Registry)

  -- Default implementations
  isTrusted provider = exercise (toInterfaceContractId @ProviderRegistry self) IsProviderTrusted with providerToCheck = provider
  addProvider provider = exercise (toInterfaceContractId @ProviderRegistry self) AddProvider with newProvider = provider
  removeProvider provider = exercise (toInterfaceContractId @ProviderRegistry self) RemoveProvider with providerToRemove = provider


instance Registry for ProviderRegistry where
  viewtype V = V with authority : Party, providers : Set Party
  asProviderRegistry = this
  isTrusted = isTrusted @Registry
  addProvider = addProvider @Registry
  removeProvider = removeProvider @Registry