module Revocation where

import DA.Set (Set)
import DA.Time (Time)
import Kyc (Attestation)

-- | Represents the revocation of a specific KYC `Attestation`.
-- The existence of this contract on the ledger for a given `attestationId`
-- signifies that the corresponding `Attestation` contract is no longer valid
-- and should not be relied upon.
--
-- This contract serves as a public (to its stakeholders) and immutable record
-- of the revocation event, providing transparency and auditability.
template Revocation
  with
    provider       : Party
      -- ^ The identity provider who issued and is now revoking the attestation.
      -- This must be the same party that signed the original `Attestation`.

    attestationId  : ContractId Attestation
      -- ^ The contract ID of the `Kyc.Attestation` being revoked. This creates a
      -- direct, on-ledger link between the revocation and the original credential.

    reason         : Text
      -- ^ A clear, human-readable reason for the revocation.
      -- E.g., "Customer reported lost credentials", "Document expired", "Fraud detected".

    revocationTime : Time
      -- ^ The official timestamp of when the revocation was recorded on the ledger.

    observers      : Set Party
      -- ^ A set of parties who are privy to this revocation. This must include the
      -- owner of the original attestation, and may include other relevant parties.

  where
    signatory provider
    observer observers

    key (provider, attestationId) : (Party, ContractId Attestation)
    maintainer key._1

    ensure
      reason /= ""

    -- | Allows the provider to archive the revocation record. This is typically
    -- done after a sufficient amount of time has passed and the record is no
    -- longer needed for active operational checks, but its history is preserved
    -- on the ledger.
    choice Archive : ()
      controller provider
      do
        pure ()