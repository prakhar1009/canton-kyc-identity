module Attestation where

import DA.Date
import DA.Time
import DA.Optional (isSome, fromSome)
import Daml.Script

-- | The specific type of verification an attestation represents. This allows for
-- | a single identity framework to support multiple kinds of checks.
data AttestationType
  = AML_KYC -- Anti-Money Laundering / Know Your Customer
  | ACCREDITED_INVESTOR -- Status as an accredited investor in a specific jurisdiction
  | QUALIFIED_PURCHASER -- Status as a qualified purchaser in a specific jurisdiction
  | PEP -- Politically Exposed Person check
  deriving (Eq, Show, Ord)

-- | Represents a verifiable claim made by a KYC Provider about a Subject.
-- This contract is the core of the identity system. It is created by a `provider`
-- for a `subject`, and both must agree to its existence on the ledger.
template Attestation
  with
    provider: Party
      -- ^ The party issuing the attestation (e.g., a KYC service, a bank).
    subject: Party
      -- ^ The party who is the subject of the attestation.
    attestationType: AttestationType
      -- ^ The type of verification performed.
    attestationId: Text
      -- ^ A unique identifier for this attestation from the provider's off-ledger system.
    issuedAt: Time
      -- ^ The timestamp when the attestation was issued.
    expiresAt: Optional Time
      -- ^ The optional timestamp when the attestation expires. If `None`, it does not expire.
    observers: [Party]
      -- ^ A list of parties who are explicitly allowed to see this attestation.
  where
    signatory provider, subject
    observer observers

    key (provider, subject, attestationType) : (Party, Party, AttestationType)
    maintainer key._1

    ensure
      -- The attestation must be issued before it expires.
      case expiresAt of
        Some expiry -> issuedAt < expiry
        None -> True

    -- | Allows the provider to revoke the attestation. This action is permanent and
    -- | creates a `RevokedAttestation` record as a tombstone, providing a clear
    -- | audit trail that the attestation is no longer valid.
    choice Revoke : ContractId RevokedAttestation
      with
        revokedAt: Time
        reason: Text
      controller provider
      do
        ensure revokedAt >= issuedAt
        create RevokedAttestation with
          provider
          subject
          attestationType
          attestationId
          revokedAt
          reason

    -- | Allows the subject to grant viewing permission to a new party. This is
    -- | a key privacy-preserving feature, giving the subject granular control
    -- | over who can see their attestation data.
    choice AddObserver : ContractId Attestation
      with
        newObserver: Party
      controller subject
      do
        -- Ensure the new observer is not the provider or subject, and not already in the list.
        assertMsg "Party is already a stakeholder or observer" (notElem newObserver (observers ++ [provider, subject]))
        create this with observers = newObserver :: observers

    -- | Allows the subject to revoke viewing permission from an existing observer.
    choice RemoveObserver : ContractId Attestation
      with
        observerToRemove: Party
      controller subject
      do
        assertMsg "Party is not an observer" (elem observerToRemove observers)
        create this with observers = filter (\p -> p /= observerToRemove) observers

-- | A record indicating that a previously issued `Attestation` has been revoked
-- | by the provider. This serves as a persistent record of the revocation event,
-- | visible to both the provider and the subject.
template RevokedAttestation
  with
    provider: Party
      -- ^ The party that issued and then revoked the attestation.
    subject: Party
      -- ^ The subject of the revoked attestation.
    attestationType: AttestationType
      -- ^ The type of the revoked attestation.
    attestationId: Text
      -- ^ The unique ID of the original attestation.
    revokedAt: Time
      -- ^ The timestamp of the revocation.
    reason: Text
      -- ^ The reason provided for the revocation.
  where
    signatory provider
    observer subject

    key (provider, subject, attestationType) : (Party, Party, AttestationType)
    maintainer key._1

-- | A convenience data type for checking the validity of an attestation.
data AttestationStatus = IsValid | IsExpired | NotPresent
  deriving (Eq, Show)

-- | Helper function to check the status of a potential attestation.
-- | It can be called from other contracts to verify a party's KYC status
-- | without needing to be an observer on the attestation contract itself.
-- | The caller must fetch the attestation first (e.g., via `fetchByKey`).
checkAttestation : Time -> Optional Attestation -> AttestationStatus
checkAttestation currentTime mbAttestation =
  case mbAttestation of
    None -> NotPresent
    Some att ->
      if isSome att.expiresAt && fromSome att.expiresAt < currentTime
        then IsExpired
        else IsValid

-- | Example usage in a Daml Script for testing and demonstration purposes.
setupPartiesAndAttestation : Script (ContractId Attestation)
setupPartiesAndAttestation = script do
  provider <- allocatePartyWithHint "KYCProvider" (PartyIdHint "kyc-provider")
  alice <- allocatePartyWithHint "Alice" (PartyIdHint "alice")
  bob <- allocatePartyWithHint "Bob" (PartyIdHint "bob")

  now <- getTime

  let att = Attestation with
        provider = provider
        subject = alice
        attestationType = AML_KYC
        attestationId = "kyc-alice-12345"
        issuedAt = now
        expiresAt = Some (addRelTime now (days 365))
        observers = []

  -- The provider proposes the attestation, and Alice must accept it.
  -- Here we simplify by having the provider submit as both signatories.
  -- In a real scenario, this would be a proposal/acceptance flow.
  attestationCid <- submitMulti [provider, alice] [] do
    createCmd att

  -- Alice adds Bob as an observer so Bob can verify her status.
  attestationCid' <- submit alice do
    exerciseCmd attestationCid AddObserver with newObserver = bob

  debug "Successfully created AML_KYC attestation for Alice, with Bob as an observer."

  return attestationCid'