module Kyc.Attestation where

import Daml.Script
import DA.Date as D
import DA.Optional (isSome)

-- | A helper record to capture the essential details of an attestation for verification purposes.
-- This prevents exposing the contract's choices or full implementation details to verification logic.
data AttestationDetails = AttestationDetails
  with
    provider: Party
    subject: Party
    attestationType: Text
    scope: Text
    expiryDate: Optional Date
  deriving (Eq, Show)

-- | Checks if an attestation is valid as of a given date.
-- An attestation is valid if it has not expired.
isAttestationValid : Date -> Attestation -> Bool
isAttestationValid currentDate attestation =
  case attestation.expiryDate of
    None -> True -- No expiry date means it's always valid.
    Some d -> d >= currentDate

-- | The core attestation template representing a single, verifiable claim made by an identity provider
-- about a subject. This attestation is purpose-limited by its `scope`.
template Attestation
  with
    provider   : Party
      -- ^ The identity provider who issues the attestation.
    subject    : Party
      -- ^ The party whose identity is being attested.
    attestationType : Text
      -- ^ The type of claim being made (e.g., "IsNaturalPerson", "IsAccreditedInvestor").
    scope      : Text
      -- ^ A specific context or purpose for which this attestation is valid (e.g., "TradingPlatformX_Onboarding").
    expiryDate : Optional Date
      -- ^ The date on which this attestation expires. If `None`, it does not expire.
    observers  : [Party]
      -- ^ A list of parties who are allowed to view this attestation.
  where
    signatory provider, subject
    observer observers

    key (provider, subject, attestationType, scope) : (Party, Party, Text, Text)
    maintainer key._1

    -- | Choice for the provider to revoke the attestation, effectively archiving it.
    -- This is used when the attested claim is no longer valid before its expiry date.
    choice Revoke : ()
      controller provider
      do
        pure ()

    -- | Choice for the subject to share this attestation with a new party, adding them as an observer.
    -- This empowers the subject to control the dissemination of their own KYC data.
    choice Share : ContractId Attestation
      with
        newObserver : Party
      controller subject
      do
        -- Ensure the new observer is not already a stakeholder to prevent redundancy.
        assertMsg "New observer is already a stakeholder of this attestation" $
          notElem newObserver (provider :: subject :: observers)

        -- Create a new version of the attestation with the updated observer list.
        -- The original contract is consumed in this process.
        create this with observers = newObserver :: observers

    -- | Non-consuming choice for an existing observer to verify the details of the attestation.
    -- This allows other contracts or off-ledger systems to check the validity of the claim
    -- without altering the state of the attestation contract.
    nonconsuming choice Verify : AttestationDetails
      controller observers
      do
        return AttestationDetails with
          provider = provider
          subject = subject
          attestationType = attestationType
          scope = scope
          expiryDate = expiryDate

-- | Daml Script for setting up and testing the Attestation template lifecycle.
setup : Script ()
setup = script do
  -- 1. Allocate parties
  provider <- allocatePartyWithHint "IdentityProvider" (PartyIdHint "idp")
  alice <- allocatePartyWithHint "Alice" (PartyIdHint "alice")
  tradingPlatform <- allocatePartyWithHint "TradingPlatform" (PartyIdHint "tradingplatform")

  -- 2. Get current time to set expiry date
  now <- getTime
  let today = D.toDateUTC now
  let expiry = D.addDays 365 today

  -- 3. Provider issues an attestation to Alice for a specific scope.
  -- Initially, only the provider and Alice can see it.
  aliceAttestationCid <- submit provider do
    createCmd Attestation with
      provider = provider
      subject = alice
      attestationType = "IsAccreditedInvestor"
      scope = "TradingPlatformX_Onboarding"
      expiryDate = Some expiry
      observers = []

  -- 4. Alice shares her attestation with the trading platform.
  attestationSharedCid <- submit alice do
    exerciseCmd aliceAttestationCid Share with newObserver = tradingPlatform

  -- 5. The trading platform verifies the attestation.
  details <- submit tradingPlatform do
    exerciseCmd attestationSharedCid (Verify)

  debug $ "Trading Platform verified attestation: " <> show details
  assert $ details.provider == provider
  assert $ details.subject == alice
  assert $ details.scope == "TradingPlatformX_Onboarding"

  -- 6. Test the validity check helper function.
  attestationContract <- queryContractId tradingPlatform attestationSharedCid
  case attestationContract of
    Some c -> do
      let isValidNow = isAttestationValid today c
      debug $ "Attestation is valid today: " <> show isValidNow
      assert isValidNow

      let futureDate = D.addDays 400 today
      let isInvalidInFuture = not $ isAttestationValid futureDate c
      debug $ "Attestation is invalid in 400 days: " <> show isInvalidInFuture
      assert isInvalidInFuture
    None ->
      abort "Could not fetch shared attestation contract"

  -- 7. Provider revokes the attestation.
  submit provider do
    exerciseCmd attestationSharedCid Revoke

  -- 8. Verification by the platform should now fail as the contract is archived.
  submitMustFail tradingPlatform do
    exerciseCmd attestationSharedCid (Verify)

  debug "Successfully tested Attestation lifecycle: Create, Share, Verify, and Revoke."

  return ()