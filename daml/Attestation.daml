-- | This module defines the core KYC Attestation template, which represents
-- a verifiable claim made by an identity provider about a subject party.
-- It includes features for expiry, revocation, and purpose-limitation via scopes.
module Attestation where

import Daml.Finance.Interface.Util.Disclosure qualified as Disclosure (I, Implementation, View)
import DA.Date
import DA.Set (Set)
import DA.Set qualified as Set

-- | Defines the level of Know-Your-Customer (KYC) verification.
-- These levels represent a simple hierarchy of assurance.
data KycLevel
  = Level1_IdentityConfirmed -- ^ Basic identity data confirmed (e.g., email, phone).
  | Level2_DocumentVerified  -- ^ Government-issued document verified (e.g., passport, driver's license).
  | VerifiedIndividual       -- ^ Full due diligence completed for a natural person.
  | VerifiedInstitution      -- ^ Full due diligence completed for a legal entity.
  deriving (Eq, Show, Ord, Read)

-- | Represents a verifiable KYC attestation issued by an identity provider.
-- The attestation is privacy-preserving, as the subject controls its disclosure
-- to other parties. The `scope` field limits the context in which the
-- attestation is considered valid, preventing its use for unintended purposes.
--
-- For example, a scope of "trading:acme-corp" means the attestation is only
-- valid for trading with Acme Corp.
template Attestation
  with
    provider     : Party
      -- ^ The identity provider issuing the attestation.
    subject      : Party
      -- ^ The party who is the subject of the attestation.
    kycLevel     : KycLevel
      -- ^ The level of KYC verification achieved.
    expiryDate   : Date
      -- ^ The date on which the attestation expires and is no longer valid.
    id           : Text
      -- ^ A unique identifier for this attestation, provided by the issuer.
    scope        : Text
      -- ^ The purpose for which this attestation can be used.
      --   Example: "trading", "onboarding:acme-bank", "asset-tokenization".
    observers    : Set Party
      -- ^ The set of parties who can view this attestation.
  where
    signatory provider
    observer observers, subject

    -- The key ensures that a provider cannot issue multiple attestations
    -- for the same subject with the same external ID.
    key (provider, subject, id) : (Party, Party, Text)
    maintainer key._1

    ensure
      -- The subject must always be in the observer set to see their own attestations.
      Set.member subject observers

    -- Implementation of the standard Disclosure interface, allowing the subject
    -- to selectively disclose their attestation to other parties.
    interface instance Disclosure.I for Attestation where
      view = Disclosure.View with disclosureControllers = Set.singleton subject
      setObservers newObservers = self with observers = newObservers

    -- | Allows the provider to revoke the attestation before its expiry date.
    -- This is achieved by archiving the contract.
    choice Revoke : ()
      controller provider
      do
        pure ()

    -- | A non-consuming choice for an observer to verify the attestation is still active.
    -- It checks that the provided date (presumably the current date) is before
    -- or on the expiry date of the attestation. This allows relying parties
    -- to confirm validity without needing further interaction from the provider.
    nonconsuming choice CheckIsActive : ()
      with
        currentDate : Date
          -- ^ The current date to check against the expiry date.
      controller observers
      do
        assertMsg ("Attestation expired on " <> show expiryDate) (currentDate <= expiryDate)