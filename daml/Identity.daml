module Daml.Identity where

import Daml.Script
import DA.Date
import DA.Time
import DA.Assert
import DA.Set (fromList, toList)
import Daml.MultiAttestation

-- | Represents a verified identity for a Party on the network.
-- This contract is the root object that links a Party to their various attestations.
-- It is controlled by both the identity owner and the issuing provider, allowing
-- for secure, auditable management of identity status and visibility.
template Identity
  with
    owner: Party
      -- ^ The party whose identity is being represented.
    provider: Party
      -- ^ The identity provider who verified and issued this identity.
    observers: [Party]
      -- ^ A list of parties who are permitted to view this identity and its attestations.
    attestationCids: [ContractId MultiAttestation]
      -- ^ A list of contract IDs for the underlying attestations (e.g., KYC, AML).
    isActive: Bool
      -- ^ A flag indicating whether the identity is currently valid or has been revoked.
    createdAt: Time
      -- ^ The timestamp when the identity was first created.
    updatedAt: Time
      -- ^ The timestamp of the last modification to this identity.
  where
    signatory owner, provider
    observer toList $ fromList observers -- Ensure observers are unique

    -- The owner can unilaterally decide to archive their identity contract.
    choice ArchiveIdentity: ()
      controller owner
      do
        pure ()

    -- The provider can revoke the identity, for example, if the underlying
    -- attestations are no longer valid.
    choice Revoke: ContractId Identity
      controller provider
      do
        now <- getTime
        assertMsg "Identity is already revoked." isActive
        create this with
          isActive = False
          updatedAt = now

    -- The provider can reinstate a previously revoked identity.
    choice Reinstate: ContractId Identity
      controller provider
      do
        now <- getTime
        assertMsg "Identity is already active." (not isActive)
        create this with
          isActive = True
          updatedAt = now

    -- The owner can add a new attestation to their identity. This requires the
    -- provider's consent to ensure the new attestation is valid.
    choice AddAttestation: ContractId Identity
      with
        newAttestationCid: ContractId MultiAttestation
      controller owner, provider
      do
        now <- getTime
        -- Verify that the new attestation is for the correct owner and provider.
        attestation <- fetch newAttestationCid
        assertMsg "New attestation must belong to the identity owner." $
          attestation.owner == owner
        assertMsg "New attestation must be from the identity provider." $
          attestation.provider == provider

        create this with
          attestationCids = newAttestationCid :: attestationCids
          updatedAt = now

    -- The owner can share their identity with a new party, granting them observer rights.
    choice ShareWith: ContractId Identity
      with
        newObserver: Party
      controller owner
      do
        now <- getTime
        assertMsg "Cannot share with existing owner, provider, or observer."
          (notElem newObserver (owner :: provider :: observers))

        create this with
          observers = newObserver :: observers
          updatedAt = now

    -- The owner can revoke a party's observer rights.
    choice UnshareWith: ContractId Identity
      with
        observerToRemove: Party
      controller owner
      do
        now <- getTime
        assertMsg "Party to remove is not an existing observer."
          (elem observerToRemove observers)

        create this with
          observers = filter (\p -> p /= observerToRemove) observers
          updatedAt = now

-- | A test suite for the Identity template and its choices.
test_IdentityLifecycle : Script ()
test_IdentityLifecycle = script do
  -- 1. Setup Parties
  owner <- allocatePartyWithHint "Owner" (PartyIdHint "owner")
  provider <- allocatePartyWithHint "Provider" (PartyIdHint "provider")
  observer1 <- allocatePartyWithHint "Observer1" (PartyIdHint "observer1")
  observer2 <- allocatePartyWithHint "Observer2" (PartyIdHint "observer2")

  -- 2. Create initial Attestation
  now <- getTime
  let attestationPayload =
        "{\"kycLevel\": \"Full\", \"jurisdiction\": \"CH\", \"verificationDate\": \"" <> show now <> "\"}"

  initialAttestationCid <- submit provider do
    createCmd MultiAttestation with
      owner
      provider
      observers = []
      attestationType = "KYC"
      payload = attestationPayload
      expiryDate = Some $ addDays (toDateUTC now) 365
      createdAt = now

  -- 3. Create Identity
  initialIdentityCid <- submitMulti [owner, provider] [] do
    createCmd Identity with
      owner
      provider
      observers = [observer1]
      attestationCids = [initialAttestationCid]
      isActive = True
      createdAt = now
      updatedAt = now

  initialIdentity <- fetch initialIdentityCid
  initialIdentity.owner === owner
  initialIdentity.provider === provider
  initialIdentity.observers === [observer1]
  assert initialIdentity.isActive

  -- 4. Share with a new observer
  sharedIdentityCid <- submit owner do
    exerciseCmd initialIdentityCid ShareWith with newObserver = observer2

  sharedIdentity <- fetch sharedIdentityCid
  sharedIdentity.observers === [observer2, observer1]

  -- 5. Attempt to share with an existing observer (should fail)
  submitMustFail owner do
    exerciseCmd sharedIdentityCid ShareWith with newObserver = observer1

  -- 6. Provider revokes the identity
  revokedIdentityCid <- submit provider do
    exerciseCmd sharedIdentityCid Revoke

  revokedIdentity <- fetch revokedIdentityCid
  assert (not revokedIdentity.isActive)
  assert (revokedIdentity.updatedAt > revokedIdentity.createdAt)

  -- 7. Attempt to revoke again (should fail)
  submitMustFail provider do
    exerciseCmd revokedIdentityCid Revoke

  -- 8. Provider reinstates the identity
  reinstatedIdentityCid <- submit provider do
    exerciseCmd revokedIdentityCid Reinstate

  reinstatedIdentity <- fetch reinstatedIdentityCid
  assert reinstatedIdentity.isActive

  -- 9. Owner and Provider add a new attestation
  let amlPayload = "{\"amlCheck\": \"Passed\", \"checkDate\": \"" <> show now <> "\"}"
  newAttestationCid <- submit provider do
    createCmd MultiAttestation with
      owner
      provider
      observers = []
      attestationType = "AML"
      payload = amlPayload
      expiryDate = None
      createdAt = now

  updatedIdentityCid <- submitMulti [owner, provider] [] do
    exerciseCmd reinstatedIdentityCid AddAttestation with newAttestationCid

  updatedIdentity <- fetch updatedIdentityCid
  length updatedIdentity.attestationCids === 2
  assert (elem newAttestationCid updatedIdentity.attestationCids)

  -- 10. Owner removes an observer
  finalIdentityCid <- submit owner do
    exerciseCmd updatedIdentityCid UnshareWith with observerToRemove = observer1

  finalIdentity <- fetch finalIdentityCid
  finalIdentity.observers === [observer2]

  -- 11. Attempt to remove a non-existent observer (should fail)
  submitMustFail owner do
    exerciseCmd finalIdentityCid UnshareWith with observerToRemove = observer1

  -- 12. Owner archives the final identity
  submit owner do
    exerciseCmd finalIdentityCid ArchiveIdentity

  -- 13. Query active contracts to ensure it's gone
  contracts <- query @Identity owner
  assert (null contracts)

  pure ()