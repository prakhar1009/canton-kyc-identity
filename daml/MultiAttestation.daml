module MultiAttestation where

import Daml.Script
import DA.Assert
import DA.List (delete, find, sum)
import DA.Optional (isSome, fromSome)
import DA.Decimal

-- In a real multi-file project, SingleAttestation would be in its own module,
-- e.g., `Main.Provider`, and imported here. For this file to be self-contained
-- and runnable, a minimal definition is provided.
module Main.Provider where
  template SingleAttestation
    with
      provider : Party
      subject : Party
      attestationType : Text
      trustScore : Decimal
    where
      signatory provider, subject

      nonconsuming choice GetView : SingleAttestation
        controller subject, provider
        do return self

import Main.Provider (SingleAttestation(..))

-- | A data record holding a reference to a `SingleAttestation` contract and
-- | key cached data from it. This prevents needing to fetch the contract
-- | for simple display purposes.
data AttestationRef = AttestationRef
  with
    cid : ContractId SingleAttestation
    provider : Party
    trustScore : Decimal
  deriving (Eq, Show)

-- | Helper function to calculate the composite score from a list of attestations.
-- | This implementation uses a simple average. In a production system, this could
-- | be a weighted average based on provider reputation or attestation type.
calculateCompositeScore : [AttestationRef] -> Decimal
calculateCompositeScore refs =
  if null refs then
    0.0
  else
    sum (map (.trustScore) refs) / intToDecimal (length refs)

-- | Aggregates multiple `SingleAttestation` contracts for a single subject.
-- | This allows the subject to present a consolidated identity view, with a
-- | composite trust score derived from multiple independent providers.
-- | The contract is uniquely keyed by the subject, ensuring one aggregate profile per party.
template MultiAttestation
  with
    subject : Party
    -- | List of references to the underlying `SingleAttestation` contracts.
    attestations : [AttestationRef]
    -- | The calculated aggregate score.
    compositeScore : Decimal
  where
    signatory subject
    -- All providers of the included attestations are observers.
    observer map (.provider) attestations

    key subject : Party
    maintainer key.signatories

    -- | The subject can add a new, valid attestation to their profile.
    choice AddAttestation : ContractId MultiAttestation
      with
        newAttestationCid : ContractId SingleAttestation
      controller subject
      do
        -- Fetch the attestation contract to verify its details.
        newAttestation <- fetch newAttestationCid

        -- Ensure the attestation belongs to the subject exercising the choice.
        assertMsg "Attestation must be for the subject"
          (newAttestation.subject == subject)

        -- Ensure an attestation from this provider is not already included.
        let providerExists = isSome $ find (\ref -> ref.provider == newAttestation.provider) attestations
        assertMsg ("An attestation from provider " <> show newAttestation.provider <> " already exists.")
          (not providerExists)

        -- Create a reference record for the new attestation.
        let newRef = AttestationRef with
              cid = newAttestationCid
              provider = newAttestation.provider
              trustScore = newAttestation.trustScore

        -- Add the new reference and recalculate the score.
        let newAttestations = newRef :: attestations
        let newScore = calculateCompositeScore newAttestations

        -- Create the new, updated MultiAttestation contract.
        create this with
          attestations = newAttestations
          compositeScore = newScore

    -- | A provider can remove their attestation, e.g., if it is revoked or expired.
    -- | This ensures the composite score remains accurate.
    choice RemoveAttestation : ContractId MultiAttestation
      with
        attestationToRemoveCid : ContractId SingleAttestation
      -- Only providers who have an attestation in this contract can act.
      controller (map (.provider) attestations)
      do
        -- Find the attestation reference to be removed.
        let maybeRefToRemove = find (\ref -> ref.cid == attestationToRemoveCid) attestations
        assertMsg "Attestation to remove not found in this aggregate"
          (isSome maybeRefToRemove)
        let refToRemove = fromSome maybeRefToRemove

        -- Ensure the controller of this choice is the provider of the specific
        -- attestation being removed.
        assertMsg "Only the original provider can remove their attestation"
          (signatory == refToRemove.provider)

        -- Remove the attestation and recalculate the score.
        let newAttestations = delete refToRemove attestations
        let newScore = calculateCompositeScore newAttestations

        -- Create the new, updated MultiAttestation contract.
        create this with
          attestations = newAttestations
          compositeScore = newScore

-- | Daml Script for setting up and testing the multi-attestation workflow.
setup : Script ()
setup = script do
  -- 1. Allocate parties
  subject <- allocatePartyWithHint "Subject" (PartyIdHint "subject")
  providerA <- allocatePartyWithHint "ProviderA" (PartyIdHint "providerA")
  providerB <- allocatePartyWithHint "ProviderB" (PartyIdHint "providerB")
  providerC <- allocatePartyWithHint "ProviderC" (PartyIdHint "providerC")

  -- 2. Providers issue attestations to the subject
  attestationACid <- subject `submit` do
    providerA `submit` do
      createCmd SingleAttestation with
        provider = providerA
        subject = subject
        attestationType = "AML_Check"
        trustScore = 0.90

  attestationBCid <- subject `submit` do
    providerB `submit` do
      createCmd SingleAttestation with
        provider = providerB
        subject = subject
        attestationType = "Address_Verification"
        trustScore = 0.80

  debug "Providers A and B issued single attestations to the Subject."

  -- 3. Subject creates an initial, empty MultiAttestation contract
  multiAttCid <- submit subject do
    createCmd MultiAttestation with
      subject = subject
      attestations = []
      compositeScore = 0.0

  debug $ "Subject created an empty MultiAttestation: " <> show multiAttCid

  -- 4. Subject adds the first attestation
  multiAttCid_1 <- submit subject do
    exerciseCmd multiAttCid (AddAttestation attestationACid)

  multiAtt_1 <- queryContractId subject multiAttCid_1
  debug $ "Subject added attestation from Provider A. Score: " <> show multiAtt_1.compositeScore
  assert (multiAtt_1.compositeScore == 0.90)

  -- 5. Subject adds the second attestation
  multiAttCid_2 <- submit subject do
    exerciseCmd multiAttCid_1 (AddAttestation attestationBCid)

  multiAtt_2 <- queryContractId subject multiAttCid_2
  debug $ "Subject added attestation from Provider B. Score: " <> show multiAtt_2.compositeScore
  -- Score should be the average: (0.90 + 0.80) / 2 = 0.85
  assert (multiAtt_2.compositeScore == 0.85)
  assert (length multiAtt_2.attestations == 2)

  -- 6. Provider A removes their attestation (simulating a revocation)
  multiAttCid_3 <- submit providerA do
    exerciseCmd multiAttCid_2 (RemoveAttestation attestationACid)

  multiAtt_3 <- queryContractId subject multiAttCid_3
  debug $ "Provider A removed their attestation. Score: " <> show multiAtt_3.compositeScore
  -- Score should revert to just Provider B's score, 0.80
  assert (multiAtt_3.compositeScore == 0.80)
  assert (length multiAtt_3.attestations == 1)

  -- 7. Test failure case: Subject tries to add an attestation belonging to another party
  otherSubject <- allocatePartyWithHint "OtherSubject" (PartyIdHint "otherSubject")
  otherAttestationCid <- submit otherSubject do
    providerC `submit` do
      createCmd SingleAttestation with
        provider = providerC, subject = otherSubject, attestationType = "Credit_Check", trustScore = 0.75

  addWrongAttestationRes <- submitMustFail subject do
    exerciseCmd multiAttCid_3 (AddAttestation otherAttestationCid)
  debug $ "Successfully failed to add an attestation for another subject: " <> show addWrongAttestationRes

  -- 8. Test failure case: Provider B tries to remove Provider A's attestation
  -- Re-add A's attestation first to set up the state
  multiAttCid_4 <- submit subject do
    exerciseCmd multiAttCid_3 (AddAttestation attestationACid)

  removeOtherAttestationRes <- submitMustFail providerB do
    exerciseCmd multiAttCid_4 (RemoveAttestation attestationACid)
  debug $ "Successfully failed when Provider B tried to remove Provider A's attestation: " <> show removeOtherAttestationRes

  return ()