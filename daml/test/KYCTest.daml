module KYCTest where

import Daml.Script
import DA.Date as Date
import DA.Time as Time
import DA.Assert
import KYC.Attestation
import MultiAttestation

-- === Test Setup ===

-- A record to hold the parties for a test scenario.
data Parties = Parties
  with
    providerA: Party
    providerB: Party
    user: Party
    verifier: Party

-- Allocates the necessary parties for the tests.
setup : Script Parties
setup = do
  providerA <- allocatePartyWithHint "ProviderA" (PartyIdHint "provider-a")
  providerB <- allocatePartyWithHint "ProviderB" (PartyIdHint "provider-b")
  user <- allocatePartyWithHint "User" (PartyIdHint "user")
  verifier <- allocatePartyWithHint "Verifier" (PartyIdHint "verifier")
  return $ Parties with ..

-- === Test Scenarios ===

-- Test the successful issuance, storage, and verification of a KYC attestation.
testHappyPath : Script ()
testHappyPath = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 365

  -- 1. User creates a MultiAttestation contract to hold their credentials.
  multiAttCid <- submit p.user do
    createCmd MultiAttestation.Contract with owner = p.user, attestations = []

  -- 2. User requests a Level 1 KYC attestation from Provider A.
  reqCid <- submit p.user do
    createCmd KYC.Attestation.Request with
      provider = p.providerA
      user = p.user
      attestationType = Level1

  -- 3. Provider A approves the request and issues the attestation contract.
  (attCid, _) <- submit p.providerA do
    exerciseCmd reqCid (Accept with expiryDate = expiry)

  -- 4. User adds the newly issued attestation to their MultiAttestation contract.
  multiAttCid' <- submit p.user do
    exerciseCmd multiAttCid (AddAttestation with attestationCid = attCid)

  -- 5. A Verifier, who trusts Provider A, successfully verifies the user's attestation.
  let requirement = Requirement with provider = p.providerA, attestationType = Level1
  submit p.verifier do
    exerciseCmd multiAttCid' (Verify with verifier = p.verifier, requirements = [requirement], currentTime = now)

  -- 6. Check that the attestation contract and multi-attestation contract exist.
  att <- queryContractId p.user attCid
  multiAtt <- queryContractId p.user multiAttCid'
  assert $ att.user == p.user
  assert $ length multiAtt.attestations == 1

  return ()

-- Test that an expired attestation cannot be successfully verified.
testExpiry : Script ()
testExpiry = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 30

  multiAttCid <- submit p.user do createCmd MultiAttestation.Contract with owner = p.user, attestations = []
  reqCid <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerA, user = p.user, attestationType = Level1
  (attCid, _) <- submit p.providerA do exerciseCmd reqCid (Accept with expiryDate = expiry)
  multiAttCid' <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCid)

  -- Advance time past the expiry date.
  let secondsIn31Days = 31 * 24 * 60 * 60
  passTime (seconds secondsIn31Days)
  expiredTime <- getTime

  -- Verification should now fail because the attestation is expired.
  let requirement = Requirement with provider = p.providerA, attestationType = Level1
  submitMustFail p.verifier do
    exerciseCmd multiAttCid' (Verify with verifier = p.verifier, requirements = [requirement], currentTime = expiredTime)

  return ()

-- Test that a provider can revoke an attestation, preventing future verification.
testRevocation : Script ()
testRevocation = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 365

  multiAttCid <- submit p.user do createCmd MultiAttestation.Contract with owner = p.user, attestations = []
  reqCid <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerA, user = p.user, attestationType = Level1
  (attCid, _) <- submit p.providerA do exerciseCmd reqCid (Accept with expiryDate = expiry)
  multiAttCid' <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCid)

  -- 1. Verification is successful before revocation.
  let requirement = Requirement with provider = p.providerA, attestationType = Level1
  submit p.verifier do
    exerciseCmd multiAttCid' (Verify with verifier = p.verifier, requirements = [requirement], currentTime = now)

  -- 2. Provider A revokes the attestation.
  submit p.providerA do exerciseCmd attCid Revoke

  -- 3. The attestation contract should no longer be active.
  att <- queryContractId p.user attCid
  assert (att == None)

  -- 4. User can prune the revoked attestation from their multi-attestation contract.
  multiAttCid'' <- submit p.user do exerciseCmd multiAttCid' PruneRevoked

  prunedMultiAtt <- queryContractId p.user multiAttCid''
  assert $ length prunedMultiAtt.attestations == 0

  -- 5. Verification should now fail because the required attestation has been revoked.
  submitMustFail p.verifier do
    exerciseCmd multiAttCid'' (Verify with verifier = p.verifier, requirements = [requirement], currentTime = now)

  return ()


-- Test successful verification when multiple attestations from different providers are required.
testMultiProviderSuccess : Script ()
testMultiProviderSuccess = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 365

  multiAttCid <- submit p.user do
    createCmd MultiAttestation.Contract with owner = p.user, attestations = []

  -- Issue attestation from Provider A
  reqCidA <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerA, user = p.user, attestationType = Level1
  (attCidA, _) <- submit p.providerA do exerciseCmd reqCidA (Accept with expiryDate = expiry)
  multiAttCid <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCidA)

  -- Issue attestation from Provider B
  reqCidB <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerB, user = p.user, attestationType = ProofOfAddress
  (attCidB, _) <- submit p.providerB do exerciseCmd reqCidB (Accept with expiryDate = expiry)
  multiAttCid <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCidB)

  -- Verifier requires both attestations.
  let reqs =
        [ Requirement with provider = p.providerA, attestationType = Level1
        , Requirement with provider = p.providerB, attestationType = ProofOfAddress
        ]
  submit p.verifier do
    exerciseCmd multiAttCid (Verify with verifier = p.verifier, requirements = reqs, currentTime = now)

  return ()

-- Test that verification fails if not all required attestations are present.
testInsufficientAttestations : Script ()
testInsufficientAttestations = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 365

  multiAttCid <- submit p.user do
    createCmd MultiAttestation.Contract with owner = p.user, attestations = []

  -- User only gets an attestation from Provider A.
  reqCidA <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerA, user = p.user, attestationType = Level1
  (attCidA, _) <- submit p.providerA do exerciseCmd reqCidA (Accept with expiryDate = expiry)
  multiAttCid' <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCidA)

  -- Verifier requires attestations from both Provider A and B.
  let reqs =
        [ Requirement with provider = p.providerA, attestationType = Level1
        , Requirement with provider = p.providerB, attestationType = ProofOfAddress
        ]

  -- Verification should fail as the attestation from Provider B is missing.
  submitMustFail p.verifier do
    exerciseCmd multiAttCid' (Verify with verifier = p.verifier, requirements = reqs, currentTime = now)

  return ()

-- Test that verification fails if the user has an attestation, but not from a provider trusted by the verifier.
testWrongProvider : Script ()
testWrongProvider = script do
  p <- setup
  now <- getTime
  let today = Date.toDateUTC now
  let expiry = Date.addDays today 365

  multiAttCid <- submit p.user do
    createCmd MultiAttestation.Contract with owner = p.user, attestations = []

  -- User gets an attestation from Provider A.
  reqCidA <- submit p.user do createCmd KYC.Attestation.Request with provider = p.providerA, user = p.user, attestationType = Level1
  (attCidA, _) <- submit p.providerA do exerciseCmd reqCidA (Accept with expiryDate = expiry)
  multiAttCid' <- submit p.user do exerciseCmd multiAttCid (AddAttestation with attestationCid = attCidA)

  -- Verifier only trusts and requires an attestation from Provider B.
  let requirement = Requirement with provider = p.providerB, attestationType = Level1

  -- Verification should fail.
  submitMustFail p.verifier do
    exerciseCmd multiAttCid' (Verify with verifier = p.verifier, requirements = [requirement], currentTime = now)

  return ()


-- === Test Runner ===

-- Main test suite that runs all defined test scenarios.
kycTests : Script ()
kycTests = script do
  debug "--- Running KYC Test: Happy Path ---"
  testHappyPath
  debug "--- KYC Test: Happy Path PASSED ---"

  debug "--- Running KYC Test: Expiry ---"
  testExpiry
  debug "--- KYC Test: Expiry PASSED ---"

  debug "--- Running KYC Test: Revocation ---"
  testRevocation
  debug "--- KYC Test: Revocation PASSED ---"

  debug "--- Running KYC Test: Multi-Provider Success ---"
  testMultiProviderSuccess
  debug "--- KYC Test: Multi-Provider Success PASSED ---"

  debug "--- Running KYC Test: Insufficient Attestations ---"
  testInsufficientAttestations
  debug "--- KYC Test: Insufficient Attestations PASSED ---"

  debug "--- Running KYC Test: Wrong Provider ---"
  testWrongProvider
  debug "--- KYC Test: Wrong Provider PASSED ---"
